BOT_TOKEN=123456:ABC...
# YouTube Data API v3 keys, comma-separated. Quota is 10,000 units/day PER PROJECT —
# create each key in a separate Google Cloud project, otherwise they share one quota.
YT_API_KEYS=AIza...,AIza...
# How many suggestions to analyse per run (each costs 102 units, cached ones are free)
TOP_N=15
REGION_RU=RU
REGION_EN=US
# Telegram user IDs allowed to use the bot, comma-separated; empty = everyone
ALLOWED_USERS=
DB_PATH=gapfinder.db
# Extra stop words (comma-separated) — suggestions containing them are skipped before spending quota
STOP_WORDS=
# Set to 0 to disable the built-in stop list (games, music, true crime)
DEFAULT_STOP=1
