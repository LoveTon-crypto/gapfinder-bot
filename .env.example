BOT_TOKEN=123456:ABC...
# YouTube Data API v3 key. Quota is 10,000 units/day per Google Cloud project.
# Need more? Request a quota extension from Google (don't split one app across projects —
# that is against the YouTube API policies and can get all keys blocked).
YT_API_KEYS=AIza...
# How many suggestions to analyse per run (each new one costs 102 units, cached ones are free)
TOP_N=8
# /deep command width
DEEP_N=15
# How long search results stay cached (days)
CACHE_DAYS=7
REGION_RU=RU
REGION_EN=US
# Telegram user IDs allowed to use the bot, comma-separated; empty = everyone
ALLOWED_USERS=
DB_PATH=gapfinder.db
# Extra stop words (comma-separated) — suggestions containing them are skipped before spending quota
STOP_WORDS=
# Set to 0 to disable the built-in stop list (games, music, true crime)
DEFAULT_STOP=1
